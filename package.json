{
  "name": "dsh-account-balance",
  "version": "0.1.0",
  "description": "DeepSeek Harness 侧边栏账号菜单余额面板：点击头像即可看到充值余额与赠金余额（Account balance in the DSH sidebar account menu).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "account",
    "balance",
    "credit"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
